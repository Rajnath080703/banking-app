# TLS termination + load balancing across both app servers with active health checks.
# `tls internal` issues a local certificate for testing; in production use the bank's domain
# (automatic ACME) or the bank's own certificate.
{
	admin off
}

localhost:443 {
	tls internal
	encode gzip
	request_body {
		max_size 11MB
	}
	reverse_proxy app1:8000 app2:8000 {
		lb_policy round_robin
		health_uri /healthz
		health_interval 10s
		fail_duration 30s
		header_up X-Request-ID {http.request.uuid}
	}
	header {
		-Server
	}
}
